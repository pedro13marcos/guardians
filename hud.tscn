[sub_resource type="GDScript" id="GDScript_ytm07"]
script/source = "extends CanvasLayer

@export var healthBar: TextureProgressBar;
@export var label: Label;
@export var energyBar: TextureProgressBar;

func _ready():
	healthBar.global_position.x = 20
	healthBar.global_position.y = 20;
	energyBar.global_position.x = DisplayServer.window_get_size().x - 220;
	energyBar.global_position.y = 20;
	healthBar.set_tint_progress(Color(0,1,0,1));
	pass
	
func atualizaVida(vida):
	healthBar.value = vida;

	if vida >= 50 && vida < 100:
		var red = ((100.0 - ((vida-50.0)*2.0))/100.0);
		healthBar.set_tint_progress(Color(red,1,0,1));
	elif vida > 0 && vida < 50:
		var green = vida/50.0
		healthBar.set_tint_progress(Color(1,green,0,1))
	

func atualizaObjetivo(inimigosMortos):
	label.text = inimigosMortos;

func atualizaEnergia(energia):
	energyBar.value = energia;



"

